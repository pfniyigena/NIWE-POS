# Default profile: your local PostgreSQL. See README "Running it".
spring.datasource.url=jdbc:postgresql://localhost:5434/pos_app
spring.datasource.username=postgres
spring.datasource.password=npf2020.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

server.port=8080

# CORS: Angular dev server (ng serve) origin
app.cors.allowed-origins=http://localhost:4200

# Fourier: "Add forget password feature" — the base URL PasswordResetService builds the emailed
# reset link against (.../reset-password?token=...). Should match wherever the frontend is
# actually served from — same value as app.cors.allowed-origins' first entry in every profile
# below, since that's the one place this app already tracks "where the frontend lives."
app.frontend-url=http://localhost:4200

# JWT
app.jwt.secret=change-this-to-a-long-random-string-before-any-real-deployment-32bytesplus
app.jwt.expiration-minutes=480

# Demo data (admin/cashier users, sample products/categories/register) seeded on first run
app.seed-demo-data=true

# Fourier: "I want to have possibility of selection on Chart while initiating the app at first
# time" (deploying this for Rwanda and Chad clients), later refined — "The Config
# app.accounting.chart-country can be forgotten easily, what if we add this on the screen then at
# first time a user select the country?" — the ADMIN now picks RWANDA or CHAD explicitly on an
# on-screen setup wizard the first time they log in on a store with no chart yet (see
# ChartSetupController), so this property is no longer the primary way this gets decided. It still
# matters as that wizard's pre-filled suggestion, and as the fallback if some posting forces a lazy
# seed before any admin ever visits the wizard — either way, whichever country actually ends up
# seeding the chart gets locked into the database (StoreSettings.chartCountry) at that moment, so
# editing this property afterward has no effect. One of: RWANDA, CHAD. See
# AccountService/ChartCountry's own javadoc — copy application-niwe.properties as the starting
# point for a new client's own profile (Rwanda or Chad), same "one Spring profile per client"
# convention either way.
app.accounting.chart-country=RWANDA

# POS
# Only used once, on first run, to seed the initial admin-manageable TaxRate row (see
# com.posapp.tax.TaxRateService and DataSeeder.seedTaxRate) — after that, tax rates live in the
# database and are managed from Admin > Settings > Taxes, not here.
app.pos.tax-rate=0.15
app.pos.currency-symbol=$
app.pos.low-stock-threshold=10

# Fourier: "Wiring a handful of business events to that same mailer" — see AlertMailService and
# its three callers (CatalogService.adjustStock, QuotationService.alertExpiringQuotations,
# CustomerCreditService.assertWithinLimit).
app.pos.quotation-expiry-warning-days=3
app.pos.credit-limit-warning-percent=90

# Fourier: "no backup/restore ... no CSV import ... no year-end archive/export" — see
# com.posapp.backup.BackupService. app.backup.directory is where .sql dump files are written
# (created if missing); app.backup.pg-dump-path/app.backup.psql-path let you point at the real
# pg_dump/psql executables if they're not on PATH (e.g. a full path on Windows). The cron below
# runs a backup nightly at 2am server time.
app.backup.directory=./backups
app.backup.cron=0 0 2 * * *
app.backup.pg-dump-path=pg_dump
app.backup.psql-path=psql

# Raised from Spring Boot's 1MB default — a CSV bulk import or an uploaded backup file to restore
# from can both comfortably exceed that.
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=100MB
