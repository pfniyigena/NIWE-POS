package com.posapp.accounting;

import com.posapp.common.BaseEntity;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.FetchType;
import jakarta.persistence.ManyToOne;
import lombok.Getter;
import lombok.Setter;

import java.math.BigDecimal;
import java.time.Instant;
import java.time.LocalDate;

/**
 * Admin &gt; Accounting &gt; Expenses &gt; New — a dedicated expense entry, distinct from every
 * *automatic* posting {@link AccountingService} makes from POS/Sale/Inventory/Manufacturing (see
 * that class's javadoc) and from a fully-manual {@link JournalEntryService#createManual} entry:
 * this is the middle ground a real bookkeeping app needs for "money the store paid out that
 * isn't a purchase order" — rent, salaries, utilities, a one-off supplier bill. {@code account}
 * IS this expense's category (Fourier's own scoping choice: rather than a separate category
 * taxonomy, "category" is simply the EXPENSE-type {@link Account} it posts against — see
 * {@code ExpenseService#create}'s validation), which is also exactly what "Expenses by Category"
 * groups on.
 *
 * <p>{@code payeeType}/{@code payeeId}/{@code payeeName} identify who was paid — {@code
 * payeeName} is always a snapshot captured at creation time (same "never rewrite history off a
 * live reference" convention as {@code OrderLine.taxCode}), so a later rename of the referenced
 * {@code Supplier}/{@code AppUser}/{@code Customer} — or its deletion — never changes what this
 * record shows. {@code paid} decides which account this expense's cash side lands in once it's
 * actually posted (see {@code ExpenseService#approve}): {@code true} (the common case) credits
 * {@code CASH}; {@code false} credits {@code ACCOUNTS_PAYABLE} instead, recording a bill received
 * but not yet paid (see {@code AccountingService#postExpense}). {@code costCenter} is optional —
 * see that class's own javadoc.
 *
 * <p>{@link #status} gates everything below it (Fourier: "Approval workflow before posting") —
 * see {@link ExpenseStatus}'s own javadoc for the full PENDING -&gt; APPROVED/REJECTED -&gt;
 * (VOIDED) lifecycle; {@code ExpenseService.create} only ever sets PENDING here, it's {@code
 * approve} that actually calls {@code AccountingService.postExpense}. {@code settledAt} is a
 * separate, later event that only ever applies to an APPROVED, still-unpaid ({@code paid ==
 * false}) bill — see {@code ExpenseService#settle} — it never changes {@code paid} itself (that
 * field is a snapshot of what was true at approval time, not a running status) and is simply null
 * for an expense that was paid up front. {@code receiptDataUrl} is a nullable data: URL for an
 * uploaded photo/PDF of the actual receipt or bill, same "data: URL straight out of FileReader"
 * convention as {@code Product.iconDataUrl}. {@code recurringTemplateId} is set only when this
 * expense was auto-generated by a {@code com.posapp.recurringexpense.RecurringExpenseTemplate}'s
 * scheduled run — purely informational (which template produced this, for display), never a JPA
 * relation, so this module stays decoupled from that one exactly like every other cross-module
 * "generated from" id in this app (e.g. {@code Invoice.salesOrderId}).
 */
@Getter
@Setter
@Entity
public class Expense extends BaseEntity {

    @Column(nullable = false)
    private LocalDate expenseDate;

    /** This expense's category — must be an EXPENSE-type account (enforced in ExpenseService.create). */
    @ManyToOne(fetch = FetchType.LAZY)
    private Account account;

    @Enumerated(EnumType.STRING)
    private PayeeType payeeType = PayeeType.OTHER;

    /** Null when payeeType is OTHER, or when the admin typed a free-text payee without picking a specific record. */
    private Long payeeId;

    /** Always set — a snapshot of the payee's display name at entry time; see class javadoc. */
    @Column(nullable = false)
    private String payeeName;

    @Column(nullable = false)
    private BigDecimal amount;

    /** True (the default) if this posts as paid immediately from Cash; false if it's a bill owed but not yet paid — see class javadoc. */
    private boolean paid = true;

    @Column(columnDefinition = "TEXT")
    private String memo;

    /** Optional — see CostCenter's own javadoc. */
    @ManyToOne(fetch = FetchType.LAZY)
    private CostCenter costCenter;

    @Enumerated(EnumType.STRING)
    private ExpenseStatus status = ExpenseStatus.PENDING;

    /** Set only by {@code ExpenseService.approve} — when this expense actually posted to Accounting, as opposed to {@code getCreatedAt()} which is only when it was logged. */
    private Instant approvedAt;

    private Instant rejectedAt;

    @Column(columnDefinition = "TEXT")
    private String rejectionReason;

    /** Set only by {@code ExpenseService.voidExpense} — see ExpenseStatus's javadoc for why this reverses rather than deletes an APPROVED expense. */
    private Instant voidedAt;

    @Column(columnDefinition = "TEXT")
    private String voidReason;

    /** Set only by {@code ExpenseService.settle} — see class javadoc. Always null for a {@code paid == true} expense. */
    private Instant settledAt;

    /** Nullable data: URL for an uploaded photo/PDF of the receipt or bill — see class javadoc. */
    @Column(columnDefinition = "TEXT")
    private String receiptDataUrl;

    /**
     * Fourier: "How business branches can be introduced?" — the branch this expense belongs to; chosen on the expense, head office by default.
     * Snapshot id (not a live reference); null reads as head office, which is also what every row
     * created before branches existed holds.
     */
    @jakarta.persistence.Column(name = "branch_id")
    private Long branchId;

    /** Set only for an expense auto-generated by a recurring template's scheduled run — see class javadoc. */
    private Long recurringTemplateId;
}
