package com.posapp.invoice;

import com.posapp.common.BaseEntity;
import com.posapp.common.GlobalDiscountType;
import jakarta.persistence.CascadeType;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.OneToMany;
import lombok.Getter;
import lombok.Setter;

import java.math.BigDecimal;
import java.time.Instant;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

/**
 * A formal, numbered invoice — either generated from one {@code com.posapp.salesorder.SalesOrder}
 * (Fourier: "Build Quotation, Invoice, and the purchase-requisition approval gate ... without
 * touching warehousing") or created standalone, with its own lines, by someone who never created a
 * Sales Order at all (Fourier: "create invoice related to the Sale Order and record payment on
 * invoice ... someone can create invoice (with invoice lines) without creating sales order"). The
 * two are told apart purely by whether {@link #salesOrderId} is set — a standalone invoice simply
 * leaves it null; nothing else about this entity differs between the two.
 * <p>
 * Deliberately holds {@link #salesOrderId} as a plain {@code Long} — never a JPA {@code
 * @ManyToOne} to the actual {@code SalesOrder} entity — so this module has zero entity coupling to
 * the Sales module; {@code InvoiceService} only ever reaches across that boundary through {@code
 * SalesOrderService}'s own public {@code getById}, the same "cross-module calls go through a
 * service's public methods" convention {@code CustomerCreditService}/{@code
 * SupplierPaymentService} already follow. {@code customerId}/{@code customerName}/{@code
 * salesOrderNumber} are denormalized at generation/creation time for the same reason every other
 * snapshot field in this app is (see {@code SalesOrderLine.productName}'s javadoc) — display never
 * needs a live join back to the Sales module.
 * <p>
 * A Sales-Order-derived invoice is generated once per order (see {@code InvoiceService.generate} —
 * a second attempt against the same order is refused while an invoice of any status already
 * exists for it) as a fixed, already-{@code ISSUED} snapshot of that order's lines/amount; nothing
 * here changes if the Sales Order changes afterward (it normally can't, once past DRAFT anyway —
 * see {@code SalesOrderStatus}'s javadoc). A standalone invoice instead starts as {@code DRAFT} —
 * freely editable until {@code InvoiceService.issue} — see {@link InvoiceStatus}'s javadoc for the
 * full lifecycle of both.
 * <p>
 * Once {@code ISSUED}, the only further move is to {@code VOID} — purely a statement that this
 * document is no longer valid. For a Sales-Order-derived invoice this never reverses anything on
 * the Sales Order itself (what the customer owes there stays governed by {@code
 * CustomerCreditService}'s own payment-allocation tracking, exactly as before this invoice
 * existed) — see {@code InvoiceService.voidInvoice}'s javadoc. A standalone invoice's own
 * revenue/receivable posting (made at {@code issue} time, since nothing else ever posts it for
 * one — see {@code AccountingService.postInvoiceIssued}) is reversed on void instead, and voiding
 * is refused outright once any payment has been recorded against it (see {@code
 * InvoiceService.voidInvoice}) — {@code InvoiceService.cancelPaidInvoice} is the separate path
 * for that case instead (Fourier: "CANCEL/CREDIT PAID INVOICE → Create Credit Note → Handle the
 * payment → Refund OR → Customer Credit"), landing on this same {@code VOID} status but also
 * stamping {@link #paymentDisposition}/{@link #refundMethod}.
 * <p>
 * {@code invoiceNumber} is this document's own human-readable identifier, same {@code "XX-" +
 * millis} convention as {@code SalesOrder.orderNumber} — its own {@code "INV-"} prefix keeps it
 * from ever colliding with that or {@code Quotation.quoteNumber}/{@code PurchaseOrder.orderNumber}.
 */
@Getter
@Setter
@Entity
public class Invoice extends BaseEntity {

    private String invoiceNumber;

    private Long salesOrderId;

    private String salesOrderNumber;

    /**
     * Fourier: "Subscriptions Module" — set only on a standalone invoice auto-generated by {@code
     * SubscriptionService}'s daily billing sweep ({@code InvoiceService.generateForSubscription}),
     * same "own nullable Long, no entity coupling" convention as {@link #salesOrderId} just above
     * — this module stays as decoupled from {@code com.posapp.subscription.Subscription} as it
     * already is from {@code SalesOrder}. Null for every invoice generated any other way.
     */
    private Long subscriptionId;

    /**
     * Fourier: "Add Recurring Invoice" — set only on a standalone invoice auto-generated by {@code
     * RecurringInvoiceTemplateService}'s daily sweep or its manual "run now" ({@code
     * InvoiceService.generateForRecurringInvoiceTemplate}), same "own nullable Long, no entity
     * coupling" convention as {@link #subscriptionId} just above — this module stays as decoupled
     * from {@code com.posapp.recurringinvoice.RecurringInvoiceTemplate} as it already is from
     * {@code Subscription}/{@code SalesOrder}. Null for every invoice generated any other way.
     */
    private Long recurringInvoiceTemplateId;

    private Long customerId;

    private String customerName;

    @Enumerated(EnumType.STRING)
    private InvoiceStatus status = InvoiceStatus.ISSUED;

    private Instant invoiceDate = Instant.now();

    /** Snapshotted from the Sales Order's own dueDate at generation time — nullable, same as SalesOrder.dueDate (unset if the order was confirmed against a customer with no default credit term). */
    private LocalDate dueDate;

    /**
     * Fourier: "when I click to Bill now, it will create an invoice from the last end date. Now
     * it is still creating same invoice with same start and end date" — the billing cycle this
     * invoice actually covers, set only on a subscription-generated invoice (see {@link
     * #subscriptionId}); null for every other invoice. {@link #periodStart} is always the
     * subscription's own {@code nextBillingDate} at the moment it was billed (i.e. the previous
     * invoice's own {@link #periodEnd} — each cycle picks up exactly where the last one left off,
     * never repeating it), and {@link #periodEnd} is that date advanced by one of the
     * subscription's own {@code billingInterval} — see {@code SubscriptionService.billOne}.
     */
    private LocalDate periodStart;

    /** See {@link #periodStart}'s own javadoc. */
    private LocalDate periodEnd;

    @Column(columnDefinition = "TEXT")
    private String notes;

    private BigDecimal totalAmount = BigDecimal.ZERO;

    /**
     * Fourier: "Except POS other module can have global discount. But again give the user to
     * configure both discount. Either on line or global" — a single discount percentage applied
     * uniformly to every line on this invoice. For a Sales-Order-derived invoice, carried
     * verbatim from the Sales Order's own {@code discountPercent} at generation time; for a
     * standalone invoice, populated only when {@code StoreSettings.discountMode} was GLOBAL at
     * the moment it was created/edited (see {@code InvoiceLine.discountPercent}'s own javadoc for
     * the PER_LINE case instead). Zero (never null) for an invoice with no discount at all, or
     * one entered per line instead.
     */
    private BigDecimal discountPercent = BigDecimal.ZERO;

    /**
     * Fourier: "Global discount should be a fixed amount or percentage with percentage as the
     * default" — how {@link #discountPercent} above was actually entered while in GLOBAL mode:
     * typed directly as a percentage ({@code PERCENT}, the default), or converted from a flat
     * amount ({@code FIXED_AMOUNT} — see {@link #discountFixedAmount}), or carried verbatim from
     * the originating Sales Order. Purely a display/edit round-trip concern; every line/tax
     * calculation downstream still reads only the resolved {@link #discountPercent}. Meaningless
     * (and left at its default) outside GLOBAL mode.
     */
    @Enumerated(EnumType.STRING)
    private GlobalDiscountType discountType = GlobalDiscountType.PERCENT;

    /**
     * Fourier: "Global discount should be a fixed amount or percentage" — the flat currency
     * amount the admin actually typed when {@link #discountType} is {@code FIXED_AMOUNT}; null
     * otherwise. {@code InvoiceService} converts this once, at save time, into the equivalent
     * {@link #discountPercent} (see {@code TaxMath.percentFromFixedAmount}) — this field is kept
     * only so re-opening a standalone draft shows back the amount that was typed, not a converted
     * percentage.
     */
    private BigDecimal discountFixedAmount;

    private Instant voidedAt;

    @Column(columnDefinition = "TEXT")
    private String voidReason;

    /**
     * Fourier: "Add credit note Menu (Void) Where we can printout them" — this document's own
     * identifier as a credit note, assigned the moment it's voided (own {@code "CN-"} prefix, same
     * convention as {@code invoiceNumber}'s {@code "INV-"}, so the two numbers are never confused
     * on the printed document). Null until voided; see {@code InvoiceService.voidInvoice}.
     */
    private String creditNoteNumber;

    /**
     * Fourier: "CANCEL/CREDIT PAID INVOICE → Create Credit Note → Handle the payment → Refund OR
     * → Customer Credit" — set only by {@code InvoiceService.cancelPaidInvoice} (the separate path
     * for a standalone invoice that already has a payment on it); null for a plain {@link
     * InvoiceService#voidInvoice} (which stays refused once any payment exists), and for every
     * invoice that was never cancelled at all.
     */
    @Enumerated(EnumType.STRING)
    private PaymentDisposition paymentDisposition;

    /** Only set when {@link #paymentDisposition} is {@code REFUND} — the payment-method code the already-collected amount was handed back out through. */
    private String refundMethod;

    @OneToMany(mappedBy = "invoice", cascade = CascadeType.ALL, orphanRemoval = true)
    private List<InvoiceLine> lines = new ArrayList<>();

    /**
     * Fourier: "How business branches can be introduced?" — the branch this invoice belongs to; inherited from its Sales Order, or chosen on a standalone invoice.
     * Null = head office, which is what a row created before branches existed holds.
     */
    @jakarta.persistence.Column(name = "branch_id")
    private Long branchId;
}
