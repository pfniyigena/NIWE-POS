<?xml version="1.0" encoding="UTF-8"?>
<!--
  v1.14.0 server logs. Three rotating files in app.logging.dir (default: the folder holding the jar when started as a jar, otherwise logs/ where the server is started):
    niwe-erp.log        everything the application logs (INFO and above)
    niwe-erp-error.log  warnings and errors only, kept longer
    niwe-access.log     one line per API call that changed something, failed or was slow (never the query string, body or token)
  Settings (application.properties, all optional):
    app.logging.dir=C:/niwe/logs   app.logging.retention-days=30   app.logging.error-retention-days=90
    app.logging.max-file-size=20MB   app.logging.total-size-cap=2GB   app.logging.level=INFO
  logging.level.<package>=DEBUG still works for a single package.
-->
<configuration scan="false">
    <springProperty scope="context" name="LOG_DIR" source="app.logging.dir" defaultValue="logs"/>
    <springProperty scope="context" name="LOG_DAYS" source="app.logging.retention-days" defaultValue="30"/>
    <springProperty scope="context" name="LOG_ERR_DAYS" source="app.logging.error-retention-days" defaultValue="90"/>
    <springProperty scope="context" name="LOG_MAX_FILE" source="app.logging.max-file-size" defaultValue="20MB"/>
    <springProperty scope="context" name="LOG_TOTAL_CAP" source="app.logging.total-size-cap" defaultValue="2GB"/>
    <springProperty scope="context" name="APP_LEVEL" source="app.logging.level" defaultValue="INFO"/>

    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{req:--}|%X{user:--}] %logger{36} - %msg%n%ex"/>
    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{28}) [%X{req:--}|%X{user:--}] - %msg%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${CONSOLE_PATTERN}</pattern></encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/niwe-erp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/niwe-erp.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE}</maxFileSize>
            <maxHistory>${LOG_DAYS}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/niwe-erp-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>WARN</level></filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/niwe-erp-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE}</maxFileSize>
            <maxHistory>${LOG_ERR_DAYS}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/niwe-access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/niwe-access.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE}</maxFileSize>
            <maxHistory>${LOG_DAYS}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{req:--}|%X{user:--}] %msg%n</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <logger name="com.posapp.access" level="INFO" additivity="false">
        <appender-ref ref="ACCESS_FILE"/>
    </logger>
    <logger name="com.posapp" level="${APP_LEVEL}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
